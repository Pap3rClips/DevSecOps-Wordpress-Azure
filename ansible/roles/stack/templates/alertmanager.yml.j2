# {{ ansible_managed }}
route:
  receiver: {{ 'discord' if alert_discord_webhook | length > 0 else 'blackhole' }}
  group_by: [alertname]
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 4h

receivers:
  # Sans canal configuré, les alertes restent visibles dans Alertmanager
  # (c'est là que le test de supervision les vérifie).
  - name: blackhole
{% if alert_discord_webhook | length > 0 %}
  - name: discord
    discord_configs:
      - webhook_url: "{{ alert_discord_webhook }}"
        send_resolved: true
{% endif %}
