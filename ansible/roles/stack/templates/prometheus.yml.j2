# {{ ansible_managed }}
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: {{ wp_env }}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]

  - job_name: blackbox-internal
    metrics_path: /probe
    params:
      module: [wordpress_internal]
    static_configs:
      - targets: ["http://wordpress:8080/wp-login.php"]
    relabel_configs: &blackbox_relabel
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115
{% if not wp_tls_internal %}

  - job_name: blackbox-external
    metrics_path: /probe
    params:
      module: [https_external]
    static_configs:
      - targets: ["https://{{ wp_fqdn }}/"]
    relabel_configs: *blackbox_relabel
{% endif %}
